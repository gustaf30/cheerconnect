# Database
# For Docker local: postgresql://postgres:postgres@localhost:5432/cheerconnect
# For Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cheerconnect"
POSTGRES_PASSWORD="postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate a 32+ character random value; never commit the result.
NEXTAUTH_SECRET=""

# Google OAuth (optional)
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (required for media uploads)
# Get credentials at: https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Gmail SMTP)
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Email alternative (optional)
RESEND_API_KEY=""

# Rate limiting (optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cron jobs (optional)
CRON_SECRET=""
