/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated
/src/generated/prisma

# claude code
.claude/
tasks/
CLAUDE.md
.superdesign/
.playwright-mcp/
dbml/
doc.md

# windows artifacts
nul

# IDE
.idea/
.vscode/
*.swp
*.swo
.env*

# Artefatos brutos da LOAD-001: um JSON e um summary por execucao. Sao
# regeneraveis e o registro que vai para o TCC vive no GOAL.md, entao o
# diretorio fica versionado so pela pasta vazia.
artifacts/load/*
!artifacts/load/.gitkeep

# PNG dos diagramas UML: sao 2,7 MB derivados de 28 KB de Mermaid versionados.
# O fonte fica no repositorio e o PNG se regenera com npm run docs:diagrams:render.
docs/diagrams/png/*
!docs/diagrams/png/.gitkeep

