{
  "name": "cheerconnect",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "node --max-http-header-size=32768 node_modules/next/dist/bin/next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-postgres-integration.mjs",
    "test:rls": "node scripts/run-rls-test.mjs",
    "test:cloudinary": "node scripts/run-cloudinary-integration.mjs",
    "test:realtime": "node scripts/test-realtime-integration.mjs",
    "test:realtime:cross-instance": "node scripts/verify-realtime-cross-instance.mjs",
    "test:sse-soak": "node scripts/sse-soak.mjs",
    "test:load": "node scripts/load-test.mjs",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "docs:sync": "node scripts/sync-openapi.mjs",
    "docs:validate": "node scripts/validate-openapi.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "emailjs": "^5.0.3",
    "framer-motion": "^12.31.0",
    "lucide-react": "^0.563.0",
    "next": "16.3.6",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-easy-crop": "^5.5.6",
    "react-hook-form": "^7.71.1",
    "resend": "^6.28.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^28.0.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "cloudinary": {
      "lodash": "4.18.1"
    },
    "prisma": {
      "mysql2": "3.23.1"
    }
  }
}
